
"""
AUMVEDA - Vendor Owner Password Recovery

Flow:
1. Owner requests a password reset email.
2. Backend verifies Owner eligibility.
3. Supabase generates a recovery token.
4. Backend emails a link containing the token hash.
5. Vendor Mobile opens the New Password screen.
6. Backend verifies the recovery token.
7. Backend rechecks Vendor Owner eligibility.
8. Backend updates the password.

Employees cannot reset passwords using this API.

IMPORTANT:
Keep this router disabled until:
- SMTP is configured.
- Mobile deep linking is tested.
- The legacy shared reset bypass is closed.
- Production rate limiting is configured.
"""

import logging
import os
import smtplib
import ssl
import threading
import time
import uuid

from collections import defaultdict, deque
from email.message import EmailMessage
from urllib.parse import urlencode

from fastapi import APIRouter, HTTPException, Request
from pydantic import BaseModel, EmailStr, Field
from supabase import create_client

from app.core.config import settings
from app.core.supabase import supabase_admin
from app.services.vendor.owner_otp_email_service import (
    _smtp_config,
)

logger = logging.getLogger(__name__)

router = APIRouter(
    prefix="/auth/owner-password",
    tags=["Vendor Owner Password Recovery"],
)

GENERIC_MESSAGE = (
    "If this email belongs to an eligible Vendor Owner, "
    "a password reset link will be sent."
)

INVALID_LINK_MESSAGE = (
    "This password reset link is invalid or expired. "
    "Please request a new link."
)

WINDOW_SECONDS = 900
MAX_IP_REQUESTS = 5
MAX_GLOBAL_REQUESTS = 100
EMAIL_COOLDOWN_SECONDS = 90

_rate_lock = threading.Lock()
_ip_attempts = defaultdict(deque)
_global_attempts = deque()
_email_last_request = {}


class RequestLinkPayload(BaseModel):
    email: EmailStr



class ResetPasswordPayload(BaseModel):
    access_token: str = Field(min_length=20)
    refresh_token: str = Field(min_length=20)
    new_password: str = Field(
        min_length=8,
        max_length=128,
    )


def _normalize_email(email):
    return str(email).strip().lower()


def _eligible_owner_id(email):
    """
    The existing protected PostgreSQL RPC verifies:
    - Auth identity and confirmed email
    - Active Vendor profile
    - Active accepted Owner membership

    The RPC must remain callable only by service_role.
    """

    response = supabase_admin.rpc(
        "lookup_vendor_owner_for_password_recovery",
        {
            "p_email": _normalize_email(email),
        },
    ).execute()

    rows = response.data or []

    if len(rows) != 1:
        return None

    try:
        return str(
            uuid.UUID(
                str(rows[0]["owner_user_id"])
            )
        )
    except (KeyError, ValueError, TypeError):
        return None


def _allow_request(ip_address, email):
    """
    Development process-level throttling.

    Production requires shared rate limiting at
    the API gateway or a shared rate-limit store.
    """

    now = time.monotonic()

    with _rate_lock:
        while (
            _global_attempts
            and now - _global_attempts[0]
            >= WINDOW_SECONDS
        ):
            _global_attempts.popleft()

        attempts = _ip_attempts[ip_address]

        while (
            attempts
            and now - attempts[0]
            >= WINDOW_SECONDS
        ):
            attempts.popleft()

        if len(_global_attempts) >= MAX_GLOBAL_REQUESTS:
            return False

        if len(attempts) >= MAX_IP_REQUESTS:
            return False

        # Count every request, including unknown emails.
        attempts.append(now)
        _global_attempts.append(now)

        # Limit memory growth in long-running processes.
        if len(_ip_attempts) > 1000:
            for key in list(_ip_attempts.keys()):
                if (
                    not _ip_attempts[key]
                    or now - _ip_attempts[key][-1]
                    >= WINDOW_SECONDS
                ):
                    del _ip_attempts[key]

        if len(_email_last_request) > 10000:
            _email_last_request.clear()

        previous = _email_last_request.get(email)

        if (
            previous is not None
            and now - previous
            < EMAIL_COOLDOWN_SECONDS
        ):
            return False

        _email_last_request[email] = now

        return True


def _recovery_base_url():
    """
    Examples:

    Development build:
    aumveda-vendor://reset-password

    Production:
    https://vendor.example.com/reset-password

    Do not use HTTP for production recovery links.
    """

    value = os.getenv(
        "AUMVEDA_VENDOR_RESET_BASE_URL",
        "",
    ).strip()

    if not value:
        raise RuntimeError(
            "Vendor recovery redirect URL is not configured."
        )

    if (
        value.startswith("https://")
        or value.startswith(
            "aumveda-vendor://reset-password"
        )
    ):
        return value

    raise RuntimeError(
        "Vendor recovery redirect URL must use "
        "HTTPS or the configured app scheme."
    )


def _build_reset_link(token_hash):
    from urllib.parse import urlsplit, urlunsplit

    base_url = _recovery_base_url()
    parts = urlsplit(base_url)

    # Keep recovery credentials out of arbitrary
    # pre-existing URL query strings or fragments.
    if parts.query or parts.fragment:
        raise RuntimeError(
            "Recovery base URL must not contain "
            "query parameters or fragments."
        )

    query = urlencode({
        "token_hash": token_hash,
        "type": "recovery",
    })

    return urlunsplit((
        parts.scheme,
        parts.netloc,
        parts.path,
        query,
        "",
    ))


def _send_recovery_link(email, reset_link):
    """
    Uses the existing configured Gmail/SMTP service.

    The link must not be printed or logged.
    """

    config = _smtp_config()

    message = EmailMessage()
    message["From"] = config["sender"]
    message["To"] = email
    message["Subject"] = (
        "AUMVEDA Vendor - Reset Your Password"
    )

    message.set_content(
        (
            "AUMVEDA Vendor Account Recovery\n\n"
            "We received a request to reset your password.\n\n"
            "Open this link to create a new password:\n\n"
            f"{reset_link}\n\n"
            "If you did not request this, ignore this email.\n\n"
            "Do not share this link with anyone."
        )
    )

    context = ssl.create_default_context()

    if config["security"] == "ssl":
        with smtplib.SMTP_SSL(
            config["host"],
            config["port"],
            timeout=15,
            context=context,
        ) as smtp:
            smtp.login(
                config["username"],
                config["password"],
            )
            smtp.send_message(message)
    else:
        with smtplib.SMTP(
            config["host"],
            config["port"],
            timeout=15,
        ) as smtp:
            smtp.ehlo()
            smtp.starttls(context=context)
            smtp.ehlo()
            smtp.login(
                config["username"],
                config["password"],
            )
            smtp.send_message(message)


def _fresh_auth_client():
    """
    Never verify recovery credentials with a
    shared, persistent authentication session.
    """

    return create_client(
        settings.supabase_url,
        settings.auth_client_key,
    )


@router.post("/request-otp")
def request_owner_password_link(
    payload: RequestLinkPayload,
    request: Request,
):
    """
    Existing endpoint path retained for compatibility.

    Despite the historical name, this now sends
    a password-reset LINK, not a numeric OTP.
    """

    generic_response = {
        "status": "success",
        "message": GENERIC_MESSAGE,
    }

    email = _normalize_email(payload.email)

    client_ip = (
        request.client.host
        if request.client
        else "unknown"
    )

    if not _allow_request(client_ip, email):
        return generic_response

    try:
        owner_id = _eligible_owner_id(email)

        if not owner_id:
            return generic_response

        # Supabase sends the recovery email directly.
        # This is available only after Owner eligibility
        # has been checked above.
        supabase_admin.auth.reset_password_for_email(
            email,
            {
                "redirect_to": (
                    "aumveda-vendor://reset-password"
                ),
            },
        )

    except Exception:
        # No token, link, email, or credentials
        # are included in the log message.
        logger.error(
            "Vendor Owner recovery request failed."
        )

    return generic_response



@router.post("/reset")
def reset_owner_password(
    payload: ResetPasswordPayload,
):
    """
    Complete a Supabase recovery session.

    IMPORTANT:
    Only eligible Vendor Owners may use this endpoint.
    Vendor Employees are not eligible.
    """

    try:
        auth_client = _fresh_auth_client()

        # Establish the session from the recovery link.
        session_response = auth_client.auth.set_session(
            payload.access_token,
            payload.refresh_token,
        )

        recovered_user = getattr(
            session_response,
            "user",
            None,
        )

        if not recovered_user:
            raise ValueError("Invalid recovery session.")

        owner_id = _eligible_owner_id(
            recovered_user.email or ""
        )

        if owner_id != str(recovered_user.id):
            raise ValueError(
                "Account is not eligible for "
                "Vendor Owner password recovery."
            )

        # Update the password through the verified
        # Supabase authentication session.
        auth_client.auth.update_user({
            "password": payload.new_password,
        })

        # End the temporary recovery session.
        try:
            auth_client.auth.sign_out()
        except Exception:
            pass

        return {
            "status": "success",
            "message": (
                "Password updated successfully. "
                "Please log in with your new password."
            ),
        }

    except Exception:
        logger.warning(
            "Vendor Owner password reset rejected."
        )

        raise HTTPException(
            status_code=400,
            detail=INVALID_LINK_MESSAGE,
        )
