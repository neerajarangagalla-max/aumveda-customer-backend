# ============================================================
# APPROVED PRODUCT REVISIONS
# ============================================================

from datetime import datetime, timezone
from fastapi import HTTPException
from postgrest.exceptions import APIError
from app.core.supabase import supabase_admin


def _revision_rpc(function_name, params):
    try:
        response = supabase_admin.rpc(
            function_name,
            params,
        ).execute()

        data = response.data

        if isinstance(data, list):
            data = data[0] if data else None

        if not data:
            raise HTTPException(
                status_code=500,
                detail="Revision operation returned no data.",
            )

        return data

    except APIError as exc:
        if exc.code == "P0001":
            raise HTTPException(
                status_code=400,
                detail=exc.message,
            ) from exc

        if exc.code == "23505":
            raise HTTPException(
                status_code=409,
                detail="A conflicting revision already exists.",
            ) from exc

        raise HTTPException(
            status_code=500,
            detail="Unable to process product revision.",
        ) from exc


def _get_vendor_revision(
    product_id,
    vendor_id,
    editable=False,
):
    query = (
        supabase_admin
        .table("product_revisions")
        .select("*")
        .eq("product_id", product_id)
        .eq("vendor_id", vendor_id)
    )

    if editable:
        query = query.eq("status", "draft")
    else:
        query = query.in_(
            "status",
            ["draft", "pending"],
        )

    response = (
        query.order("created_at", desc=True)
        .limit(1)
        .execute()
    )

    rows = response.data or []

    if not rows and not editable:
        response = (
            supabase_admin
            .table("product_revisions")
            .select("*")
            .eq("product_id", product_id)
            .eq("vendor_id", vendor_id)
            .order("created_at", desc=True)
            .limit(1)
            .execute()
        )
        rows = response.data or []

    if not rows:
        raise HTTPException(
            status_code=404,
            detail="Product revision not found.",
        )

    return rows[0]


def _save_vendor_revision(revision, updates):

    response = (
        supabase_admin
        .table("product_revisions")
        .update({
            **updates,
            "updated_at": datetime.now(
                timezone.utc
            ).isoformat(),
        })
        .eq("id", revision["id"])
        .eq("vendor_id", revision["vendor_id"])
        .eq("status", "draft")
        .eq("updated_at", revision["updated_at"])
        .execute()
    )

    rows = response.data or []

    if not rows:
        raise HTTPException(
            status_code=409,
            detail=(
                "Revision has changed or was submitted. "
                "Refresh and try again."
            ),
        )

    return rows[0]


@router.post("/{product_id}/revision")
def vendor_create_revision(
    product_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):
    return _revision_rpc(
        "create_product_revision",
        {
            "p_product_id": product_id,
            "p_vendor_id": vendor_context["vendor_id"],
        },
    )


@router.get("/{product_id}/revision")
def vendor_get_revision(
    product_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.view")
    ),
):
    return _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
    )


@router.patch("/{product_id}/revision")
def vendor_update_revision(
    product_id: str,
    payload: VendorProductUpdateRequest,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):
    vendor_id = vendor_context["vendor_id"]

    revision = _get_vendor_revision(
        product_id,
        vendor_id,
        editable=True,
    )

    changes = payload.model_dump(
        mode="json",
        exclude_unset=True,
    )

    allowed_fields = {
        "category_id",
        "name",
        "short_description",
        "description",
        "ingredients",
        "benefits",
        "directions",
        "warnings",
    }

    data = dict(revision["product_data"])

    data.update({
        key: value
        for key, value in changes.items()
        if key in allowed_fields
    })

    if len(str(data.get("name") or "").strip()) < 2:
        raise HTTPException(
            status_code=400,
            detail="Product name is required.",
        )

    if not data.get("category_id"):
        raise HTTPException(
            status_code=400,
            detail="Product category is required.",
        )

    return _save_vendor_revision(
        revision,
        {"product_data": data},
    )


@router.post("/{product_id}/revision/submit")
def vendor_submit_revision(
    product_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):
    vendor_id = vendor_context["vendor_id"]

    revision = _get_vendor_revision(
        product_id,
        vendor_id,
        editable=True,
    )

    return _revision_rpc(
        "submit_product_revision",
        {
            "p_revision_id": revision["id"],
            "p_vendor_id": vendor_id,
        },
    )



# ============================================================
# PRODUCT REVISION IMAGES AND VARIANTS
# ============================================================

from uuid import uuid4

from app.services.vendor.product_image_service import (
    PRODUCT_IMAGE_BUCKET,
    MAX_IMAGE_SIZE_BYTES,
    ALLOWED_IMAGE_TYPES,
    _get_extension,
    _public_url_for_path,
)

from app.services.vendor.product_service import (
    _build_variant_attributes,
    _validate_variant_values,
    _ensure_unique_sku,
    _normalize_variant,
)


# ============================================================
# REVISION IMAGES
# ============================================================


@router.get("/{product_id}/revision/images")
def vendor_get_revision_images(
    product_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.view")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
    )

    return revision.get("images_data", [])


@router.post("/{product_id}/revision/images")
async def vendor_upload_revision_image(
    product_id: str,
    file: UploadFile = File(...),
    alt_text: str | None = Form(default=None),
    sort_order: int = Form(default=0),
    is_primary: bool = Form(default=False),
    vendor_context=Depends(
        require_vendor_permission("products.images")
    ),
):

    vendor_id = vendor_context["vendor_id"]

    revision = _get_vendor_revision(
        product_id,
        vendor_id,
        editable=True,
    )

    content_type = (
        file.content_type or ""
    ).lower()

    if content_type not in ALLOWED_IMAGE_TYPES:
        raise HTTPException(
            status_code=400,
            detail="Use JPG, PNG or WEBP images.",
        )

    file_bytes = await file.read(
        MAX_IMAGE_SIZE_BYTES + 1
    )

    if not file_bytes:
        raise HTTPException(
            status_code=400,
            detail="Image file is empty.",
        )

    if len(file_bytes) > MAX_IMAGE_SIZE_BYTES:
        raise HTTPException(
            status_code=400,
            detail="Image must be 8 MB or smaller.",
        )

    extension = _get_extension(
        file.filename,
        content_type,
    )

    image_id = str(uuid4())

    storage_path = (
        f"{vendor_id}/{product_id}/revisions/"
        f"{revision['id']}/{image_id}{extension}"
    )

    try:
        supabase_admin.storage.from_(
            PRODUCT_IMAGE_BUCKET
        ).upload(
            path=storage_path,
            file=file_bytes,
            file_options={
                "content-type": content_type,
                "upsert": "false",
            },
        )

        image_url = _public_url_for_path(
            storage_path
        )

    except Exception as exc:
        raise HTTPException(
            status_code=500,
            detail="Unable to upload revision image.",
        ) from exc

    images = list(
        revision.get("images_data") or []
    )

    primary = is_primary or not images

    if primary:
        for image in images:
            image["is_primary"] = False

    new_image = {
        "id": image_id,
        "product_id": product_id,
        "variant_id": None,
        "image_url": image_url,
        "alt_text": alt_text,
        "sort_order": max(0, sort_order),
        "is_primary": primary,
    }

    images.append(new_image)

    _save_vendor_revision(
        revision,
        {"images_data": images},
    )

    return new_image


@router.patch(
    "/{product_id}/revision/images/{image_id}/primary"
)
def vendor_set_revision_primary_image(
    product_id: str,
    image_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.images")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
        editable=True,
    )

    images = list(
        revision.get("images_data") or []
    )

    if not any(
        image["id"] == image_id
        for image in images
    ):
        raise HTTPException(
            status_code=404,
            detail="Revision image not found.",
        )

    for image in images:
        image["is_primary"] = (
            image["id"] == image_id
        )

    return _save_vendor_revision(
        revision,
        {"images_data": images},
    )


@router.delete(
    "/{product_id}/revision/images/{image_id}"
)
def vendor_delete_revision_image(
    product_id: str,
    image_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.images")
    ),
):

    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
        editable=True,
    )

    existing_images = revision.get(
        "images_data"
    ) or []

    images = [
        image
        for image in existing_images
        if image["id"] != image_id
    ]

    if len(images) == len(existing_images):
        raise HTTPException(
            status_code=404,
            detail="Revision image not found.",
        )

    if images and not any(
        image.get("is_primary")
        for image in images
    ):
        images[0]["is_primary"] = True

    # Remove only the draft image reference.
    # Published Storage files remain untouched.

    return _save_vendor_revision(
        revision,
        {"images_data": images},
    )


# ============================================================
# REVISION VARIANTS
# ============================================================


def _revision_unique_sku(
    variants,
    sku,
    variant_id=None,
):
    sku = str(sku or "").strip()

    if not sku:
        raise HTTPException(
            status_code=400,
            detail="SKU is required.",
        )

    for item in variants:
        if (
            item.get("sku") == sku
            and item.get("id") != variant_id
        ):
            raise HTTPException(
                status_code=409,
                detail="Duplicate SKU in revision.",
            )

    _ensure_unique_sku(
        sku,
        exclude_variant_id=variant_id,
    )

    return sku


def _revision_variant_is_published(
    product_id,
    variant_id,
):
    response = (
        supabase_admin
        .table("product_variants")
        .select("id")
        .eq("id", variant_id)
        .eq("product_id", product_id)
        .limit(1)
        .execute()
    )

    return bool(response.data)


@router.get("/{product_id}/revision/variants")
def vendor_get_revision_variants(
    product_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.view")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
    )

    product_variants_response = (
        supabase_admin
        .table("product_variants")
        .select("id,stock_quantity,attributes")
        .eq("product_id", product_id)
        .execute()
    )

    live_variants = {
        item["id"]: item
        for item in (
            product_variants_response.data or []
        )
    }

    result = []

    for item in revision.get("variants_data") or []:

        variant = dict(item)

        live = live_variants.get(
            variant["id"]
        )

        variant["is_published_variant"] = (
            live is not None
        )

        if live is not None:

            variant["stock_quantity"] = live.get(
                "stock_quantity", 0
            )

            attributes = dict(
                variant.get("attributes") or {}
            )

            attributes["low_stock_threshold"] = (
                live.get("attributes") or {}
            ).get("low_stock_threshold", 5)

            variant["attributes"] = attributes

        result.append(
            _normalize_variant(variant)
        )

    return result


@router.post("/{product_id}/revision/variants")
def vendor_create_revision_variant(
    product_id: str,
    payload: VendorVariantCreateRequest,
    vendor_context=Depends(
        require_vendor_permission("products.create")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
        editable=True,
    )

    variants = list(
        revision.get("variants_data") or []
    )

    data = payload.model_dump(mode="json")

    variant = {
        "id": str(uuid4()),
        "product_id": product_id,
        "name": data.get("name"),
        "sku": _revision_unique_sku(
            variants,
            data.get("sku"),
        ),
        "price": data["price"],
        "compare_at_price": data.get(
            "compare_at_price"
        ),
        "cost_price": data.get("cost_price"),
        "stock_quantity": data.get(
            "stock_quantity", 0
        ),
        "is_active": data.get(
            "is_active", True
        ),
        "attributes": _build_variant_attributes(
            data,
            {
                "low_stock_threshold": 5,
                "is_default": False,
            },
        ),
    }

    _validate_variant_values(variant)

    if variant["attributes"].get("is_default"):
        for item in variants:
            item.setdefault(
                "attributes", {}
            )["is_default"] = False

    variants.append(variant)

    _save_vendor_revision(
        revision,
        {"variants_data": variants},
    )

    return _normalize_variant(variant)


@router.patch(
    "/{product_id}/revision/variants/{variant_id}"
)
def vendor_update_revision_variant(
    product_id: str,
    variant_id: str,
    payload: VendorVariantUpdateRequest,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
        editable=True,
    )

    variants = list(
        revision.get("variants_data") or []
    )

    changes = payload.model_dump(
        mode="json",
        exclude_unset=True,
    )

    # Live inventory must use the inventory API.
    if (
        "stock_quantity" in changes
        or "low_stock_threshold" in changes
    ):
        raise HTTPException(
            status_code=400,
            detail=(
                "Use Inventory Management for "
                "stock and stock threshold adjustments."
            ),
        )

    for item in variants:

        if item["id"] != variant_id:
            continue

        if "sku" in changes:
            changes["sku"] = _revision_unique_sku(
                variants,
                changes["sku"],
                variant_id,
            )

        for key in (
            "name",
            "sku",
            "price",
            "compare_at_price",
            "cost_price",
            "is_active",
        ):
            if key in changes:
                item[key] = changes[key]

        item["attributes"] = (
            _build_variant_attributes(
                changes,
                item.get("attributes") or {},
            )
        )

        if (
            item.get("price") is None
            or float(item["price"]) <= 0
        ):
            raise HTTPException(
                status_code=400,
                detail="Variant price must be positive.",
            )

        if item.get("is_active") is None:
            raise HTTPException(
                status_code=400,
                detail="Variant active status is required.",
            )

        _validate_variant_values(item)

        if changes.get("is_default") is True:
            for other in variants:
                if other["id"] != variant_id:
                    other.setdefault(
                        "attributes", {}
                    )["is_default"] = False

        _save_vendor_revision(
            revision,
            {"variants_data": variants},
        )

        return _normalize_variant(item)

    raise HTTPException(
        status_code=404,
        detail="Revision variant not found.",
    )


@router.delete(
    "/{product_id}/revision/variants/{variant_id}"
)
def vendor_remove_revision_variant(
    product_id: str,
    variant_id: str,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):
    revision = _get_vendor_revision(
        product_id,
        vendor_context["vendor_id"],
        editable=True,
    )

    variants = list(
        revision.get("variants_data") or []
    )

    if not any(
        item["id"] == variant_id
        for item in variants
    ):
        raise HTTPException(
            status_code=404,
            detail="Revision variant not found.",
        )

    published = _revision_variant_is_published(
        product_id,
        variant_id,
    )

    if published:

        for item in variants:
            if item["id"] == variant_id:
                item["is_active"] = False
                item.setdefault(
                    "attributes", {}
                )["is_default"] = False

    else:

        variants = [
            item
            for item in variants
            if item["id"] != variant_id
        ]

    images = list(
        revision.get("images_data") or []
    )

    for image in images:
        if image.get("variant_id") == variant_id:
            image["variant_id"] = None

    _save_vendor_revision(
        revision,
        {
            "variants_data": variants,
            "images_data": images,
        },
    )

    return {
        "success": True,
        "message": (
            "Variant removal saved in revision."
        ),
        "requires_admin_approval": True,
    }



# ============================================================
# PRODUCT DELETION APPROVAL
# ============================================================

from pydantic import BaseModel, Field
from uuid import UUID


class ProductDeletionRequestPayload(BaseModel):
    reason: str = Field(min_length=1, max_length=1000)


def _get_deletion_product(product_id, vendor_id):

    response = (
        supabase_admin
        .table("products")
        .select("id,vendor_id,name,status,approval_status")
        .eq("id", str(product_id))
        .eq("vendor_id", vendor_id)
        .limit(1)
        .execute()
    )

    rows = response.data or []

    if not rows or rows[0]["status"] == "deleted":
        raise HTTPException(
            status_code=404,
            detail="Product not found.",
        )

    return rows[0]


# ============================================================
# REQUEST DELETION
# ============================================================

@router.post("/{product_id}/deletion-request")
def vendor_request_product_deletion(
    product_id: UUID,
    payload: ProductDeletionRequestPayload,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):

    vendor_id = vendor_context["vendor_id"]

    product = _get_deletion_product(
        product_id,
        vendor_id,
    )

    if (
        product["status"] != "active"
        or product["approval_status"] != "approved"
    ):
        raise HTTPException(
            status_code=400,
            detail="Only active approved products can request deletion.",
        )

    reason = payload.reason.strip()

    if not reason:
        raise HTTPException(
            status_code=400,
            detail="Deletion reason is required.",
        )

    try:

        response = supabase_admin.rpc(
            "request_product_deletion",
            {
                "p_product_id": str(product_id),
                "p_vendor_id": vendor_id,
                "p_reason": reason,
            },
        ).execute()

        data = response.data

        if isinstance(data, list):
            data = data[0] if data else None

        if not data:
            raise HTTPException(
                status_code=500,
                detail="Deletion request returned no data.",
            )

        return {
            "success": True,
            "message": "Product deletion request submitted for Admin approval.",
            "data": data,
        }

    except APIError as exc:

        if exc.code == "23505":
            raise HTTPException(
                status_code=409,
                detail="A deletion request is already pending.",
            ) from exc

        if exc.code == "P0001":
            raise HTTPException(
                status_code=400,
                detail=exc.message,
            ) from exc

        raise HTTPException(
            status_code=500,
            detail="Unable to submit product deletion request.",
        ) from exc


# ============================================================
# GET DELETION REQUEST STATUS
# ============================================================

@router.get("/{product_id}/deletion-request")
def vendor_get_product_deletion_request(
    product_id: UUID,
    vendor_context=Depends(
        require_vendor_permission("products.view")
    ),
):

    vendor_id = vendor_context["vendor_id"]

    response = (
        supabase_admin
        .table("product_deletion_requests")
        .select("*")
        .eq("product_id", str(product_id))
        .eq("vendor_id", vendor_id)
        .order("created_at", desc=True)
        .limit(1)
        .execute()
    )

    rows = response.data or []

    return {
        "success": True,
        "data": rows[0] if rows else None,
    }


# ============================================================
# SOFT DELETE UNPUBLISHED DRAFT
# ============================================================

@router.delete("/{product_id}/draft")
def vendor_delete_draft_product(
    product_id: UUID,
    vendor_context=Depends(
        require_vendor_permission("products.update")
    ),
):

    vendor_id = vendor_context["vendor_id"]

    product = _get_deletion_product(
        product_id,
        vendor_id,
    )

    if (
        product["status"] != "draft"
        or product["approval_status"] is not None
    ):
        raise HTTPException(
            status_code=400,
            detail="Only unpublished draft products can be deleted directly.",
        )

    response = (
        supabase_admin
        .table("products")
        .update({
            "status": "deleted",
            "is_featured": False,
            "updated_at": datetime.now(
                timezone.utc
            ).isoformat(),
        })
        .eq("id", str(product_id))
        .eq("vendor_id", vendor_id)
        .eq("status", "draft")
        .is_("approval_status", "null")
        .execute()
    )

    if not response.data:
        raise HTTPException(
            status_code=409,
            detail="Product status changed. Refresh and try again.",
        )

    return {
        "success": True,
        "message": "Draft product deleted successfully.",
        "product_id": str(product_id),
    }
